#!name=Dynamic iOS Location Spoofer
#!desc=SLSD Runtime v3: save/query/clear/version bridge. TLS must succeed first; system-location compatibility is not guaranteed.
#!author=Haaawy + OpenAI integration
#!homepage=https://github.com/Haaawy/SLSD-Runtime
#!category=Tools

[Script]
SLSD Settings Bridge = type=http-request,pattern=^https?:\/\/gs-loc(?:-cn)?\.apple\.com\/wloc-settings\/(?:save|version)(?:\?.*)?$,requires-body=0,max-size=0,timeout=5,script-path=https://raw.githubusercontent.com/Haaawy/SLSD-Runtime/main/slsd-settings-bridge.js?v=20260927-3
SLSD HTTP Settings Alias = type=http-request,pattern=^http:\/\/slsd\.local\/settings(?:\?.*)?$,requires-body=0,max-size=0,timeout=5,script-path=https://raw.githubusercontent.com/Haaawy/SLSD-Runtime/main/slsd-settings-bridge.js?v=20260927-3
Dynamic iOS Location Spoofer = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/Haaawy/SLSD-Runtime/main/location-spoofer-dynamic.js

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
